# --- Neon Postgres ---
# Full connection string from Neon dashboard. Note the sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Async variant for FastAPI async routes (swap psycopg for asyncpg).
DATABASE_URL_ASYNC=postgresql+asyncpg://USER:PASSWORD@ep-xxx-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Pool tuning for Neon serverless (keep small; Neon scales connections)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- App ---
ACCD_ENV=development
ACCD_SECRET_KEY=change-me
ACCD_LOG_LEVEL=INFO
ACCD_ROOT=.
ACCD_BUCKETS_DIR=./buckets
ACCD_SANDBOX_BACKEND=subprocess
ACCD_LTM_ACCESS_ROLES=owner,ceo,c_suite,hr
ACCD_TRIGGER_TOKENS=@AI,@Accodite
ACCD_DEFAULT_DIALECT=en
ACCD_EMBED_DIM=768
ACCD_HEAD_DIM=16
ACCD_N_HEADS=140
ACCD_N_LAYERS=4
ACCD_D_MODEL=2240

# --- External APIs (optional) ---
# GITHUB_TOKEN=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Rate limits ---
ACCD_RATE_LIMIT_PER_MIN=60
ACCD_MAX_HTTP_BYTES=2000000
ACCD_SANDBOX_TIMEOUT_S=15
ACCD_SANDBOX_MEMORY_MB=256

# --- Feature flags ---
ACCD_ENABLE_LSP=true
ACCD_ENABLE_TREE_SITTER=true
ACCD_ENABLE_EXTERNAL=true
ACCD_ENABLE_WEB_CRAWLER=true
ACCD_ENABLE_TRAINING=false
ACCD_ENABLE_PSTMPERSIST=false
ACCD_ENABLE_CRISIS_BOARD=true
ACCD_ENABLE_AUTO_PROMOTE=false

# --- HF Spaces ---
# PORT=7860

# --- Async DB note ---
# Async SQLAlchemy (FastAPI async routes) requires greenlet.
#   pip install greenlet
# Without greenlet, sync paths (CLI, tools, verification) still work.
