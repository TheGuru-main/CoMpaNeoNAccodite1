# =============================================================================
# Accodite environment variables
# Copy to .env for local; set as secrets/vars in the hosting dashboard.
# =============================================================================

# --- Instance / app ---
ACCD_ENV=development
ACCD_ROOT=.
ACCD_LOG_LEVEL=INFO

# --- Neon Postgres (required) ---
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_ASYNC=postgresql+asyncpg://USER:PASSWORD@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require

# --- Connection pool tuning ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Auth secrets ---
SECRET_KEY=change-me-in-production
PUBLIC_API_KEY=change-me-public-api-key

# --- External data sources ---
GITHUB_TOKEN=
GNEWS_API_KEY=
ALPHA_VANTAGE_API_KEY=
FMP_API_KEY=
YOUTUBE_API_KEY=
APITUBE_API_KEY=
APITUBE_API_BASE_URL=
APITUBE_VIDEO_SEARCH_PATH=

# --- ScrapingBee (replaces YouTube for media domain) ---
SCRAPINGBEE_API_KEY=
