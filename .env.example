# PostgreSQL / Neon database URL
DATABASE_URL=postgresql+psycopg2://user:password@host:5432/companion_db

# Secret key for JWT token signing
SECRET_KEY=your-secret-key-here

# Public API key for external access (optional)
PUBLIC_API_KEY=your-public-api-key

# GNews API key (optional)
GNEWS_API_KEY=

# GitHub token for ebooks search (optional, increases rate limit)
GITHUB_TOKEN=

# Alpha Vantage API key (for stock data)
ALPHA_VANTAGE_API_KEY=

# Financial Modelling Prep API key (for financial data)
FMP_API_KEY=
